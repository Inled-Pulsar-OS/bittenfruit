---
import Layout from '@/layouts/Layout.astro';
import HeroSection from '@/components/HeroSection.astro';
import PinnedFeaturesSection from '@/components/PinnedFeaturesSection.astro';
import StorySection from '@/components/StorySection.astro';
import EcosystemSection from '@/components/EcosystemSection.astro';
import CloudProvidersSection from '@/components/CloudProvidersSection.astro';
import EditionsSection from '@/components/EditionsSection.astro';
import VerifyIsoSection from '@/components/VerifyIsoSection.astro';
import BenefitsSection from '@/components/BenefitsSection.astro';
import RecoverySection from '@/components/RecoverySection.astro';
import FAQSection from '@/components/FAQSection.astro';
import CommunitySection from '@/components/CommunitySection.astro';
import ResourcesSection from '@/components/ResourcesSection.astro';
import { SITE_CONFIG } from '@/config/site';
---

<Layout title={`${SITE_CONFIG.name} — ${SITE_CONFIG.brandTagline}`}>
  <HeroSection />
  <PinnedFeaturesSection />
  <BenefitsSection />
  <EcosystemSection />
  <EditionsSection />
  <RecoverySection />
  <CloudProvidersSection />
  <StorySection />
  <FAQSection />
  <CommunitySection />
  <ResourcesSection />
</Layout>

<script>
  import { initHeroReveal, cleanupHeroReveal } from '@/animations/hero-reveal';
  import { initHeroPullUp, cleanupHeroPullUp } from '@/animations/hero-pullup';
  import { initScrollReveal, cleanupScrollReveal } from '@/animations/scroll-reveal';
  import { initInteractiveStory, cleanupInteractiveStory } from '@/animations/interactive-story';
  function initPage() {
    const root = document.getElementById('main-root');
    if (!root) return;

    initHeroReveal(root);
    initHeroPullUp(root);
    initScrollReveal(root);
    initInteractiveStory(root);

    document.getElementById('btn-scroll-top')?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  function cleanupPage() {
    cleanupHeroReveal();
    cleanupHeroPullUp();
    cleanupScrollReveal();
    cleanupInteractiveStory();
  }

  document.addEventListener('astro:page-load', initPage);
  document.addEventListener('astro:before-swap', cleanupPage);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPage);
  } else {
    initPage();
  }
</script>
