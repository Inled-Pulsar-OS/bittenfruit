---
import { getLocale } from '@/i18n/config';
import { getContent } from '@/i18n';

const locale = getLocale(Astro.url.pathname);
const t = getContent(locale);

// Apple "Y mucho más." style: no cards — left-aligned icon, bold lead sentence,
// then body text, all grouped as plain text columns. Icons stay in code.
const benefitIcons = [
  "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
  "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z",
  "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4",
  "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
  "M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z",
];
---

<section id="benefits-section" aria-label={t.benefits.aria} class="py-24 sm:py-36 bg-surface-default text-on-surface-default px-4 sm:px-6 border-t border-neutral-100">
  <div class="max-w-7xl mx-auto">
    <h2 class="gsap-text-reveal text-4xl sm:text-6xl font-bold font-display tracking-tight mb-16 sm:mb-20">
      {t.benefits.heading}
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-14">
      {t.benefits.items.map((benefit, index) => (
        <div class="gsap-bento-card flex flex-col items-start text-left">
          <div class="size-11 rounded-[var(--radius-md)] bg-primary/10 text-primary flex items-center justify-center mb-5">
            <svg class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d={benefitIcons[index] ?? ''} />
            </svg>
          </div>
          <p class="text-on-surface-muted text-[15px] sm:text-base leading-relaxed">
            <strong class="text-on-surface-default font-semibold">{benefit.title}</strong>
            {' '}{benefit.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
