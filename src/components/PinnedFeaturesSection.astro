---
import { GALLERY_FEATURES } from '@/config/site';
---

<section
  id="features-section"
  aria-label="Pulsar OS Features"
  class="relative bg-[#f5f5f7] text-[#1d1d1f] border-t border-neutral-100 overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-24 sm:py-36">
    <header class="text-center mb-24 sm:mb-32">
      <h2 class="text-4xl sm:text-6xl font-bold font-display tracking-tight text-[#1d1d1f] mb-6 leading-tight">
        Everything Pulsar OS can do
      </h2>
      <p class="text-lg sm:text-xl text-on-surface-muted max-w-2xl mx-auto leading-relaxed">
        Discover the features that make Bitten Fruit the real MacOS experience on Linux.
      </p>
    </header>

    <div class="space-y-24 sm:space-y-32">
      {GALLERY_FEATURES.map((feature, index) => (
        <article
          id={`feature-${index}`}
          class={`feature-block relative flex flex-col lg:flex-row items-center gap-12 lg:gap-24 ${
            index % 2 === 1 ? 'lg:flex-row-reverse' : ''
          }`}
        >
          <!-- Texto a un lado -->
          <div class="flex-1 lg:w-[45%] flex flex-col justify-center z-10">
            <h3 class="text-4xl sm:text-5xl lg:text-6xl font-bold font-display text-[#1d1d1f] mb-6 leading-tight">
              {feature.title}
            </h3>
            <p class="text-lg sm:text-xl text-on-surface-muted leading-relaxed mb-10 max-w-lg">
              {feature.description}
            </p>
          </div>

          <!-- Video al otro lado -->
          <div class="flex-1 lg:w-[55%] flex justify-center items-center z-10">
            <figure
              class="rounded-[32px] overflow-hidden border border-neutral-200 bg-black aspect-video w-full shadow-xl relative group"
            >
              <video
                src={feature.video}
                poster={feature.poster}
                autoplay
                loop
                muted
                playsinline
                preload="metadata"
                aria-label={`Video demo for ${feature.title}`}
                class="w-full h-full object-cover object-center"
              ></video>
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            </figure>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* Reducido movimiento: videos sin autoplay loop si el usuario prefiere menos movimiento */
  @media (prefers-reduced-motion: reduce) {
    .feature-block video {
      animation: none !important;
    }
  }
</style>