---
const links = [
  {
    title: "App Store",
    description: "Install apps built by the PulsarOS community, reviewed by AI.",
    href: "https://store-os.inled.es/",
    iconBody:
      '<path d="M15 21v-5a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v5"/><path d="M17.774 10.31a1.12 1.12 0 0 0-1.549 0 2.5 2.5 0 0 1-3.451 0 1.12 1.12 0 0 0-1.548 0 2.5 2.5 0 0 1-3.452 0 1.12 1.12 0 0 0-1.549 0 2.5 2.5 0 0 1-3.77-3.248l2.889-4.184A2 2 0 0 1 7 2h10a2 2 0 0 1 1.653.873l2.895 4.192a2.5 2.5 0 0 1-3.774 3.244"/><path d="M4 10.95V19a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8.05"/>',
  },
  {
    title: "Help & Docs",
    description: "Guides for installation, hardware, contributing and more.",
    href: "https://os.inled.es/help/",
    iconBody:
      '<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/>',
  },
  {
    title: "Resources",
    description: "Banners, logos and media assets to share PulsarOS.",
    href: "https://os.inled.es/resources/",
    iconBody:
      '<path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/><path d="M12 22V12"/><polyline points="3.29 7 12 12 20.71 7"/><path d="m7.5 4.27 9 5.15"/>',
  },
  {
    title: "Report a Bug",
    description: "Something broke? Tell us at BugMe and we'll fix it.",
    href: "https://bugme-os.inled.es/",
    iconBody:
      '<rect width="8" height="14" x="8" y="6" rx="4"/><path d="m19 7-3 2"/><path d="m5 7 3 2"/><path d="m19 19-3-2"/><path d="m5 19 3-2"/><path d="m20 13h-4"/><path d="m4 13h4"/><path d="m10 4 1 2"/><path d="m14 4-1 2"/>',
  },
  {
    title: "RSS Feed",
    description: "Subscribe and get every release and news in your reader.",
    href: "https://feed-os.inled.es/",
    iconBody:
      '<path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/>',
  },
];
---

<!-- Final resources / links section -->
<section id="resources-section" class="py-24 sm:py-32 bg-surface-muted text-on-surface-default px-4 sm:px-6 border-t border-neutral-100">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-4xl sm:text-6xl font-bold font-display tracking-tight text-on-surface-default leading-tight text-center mb-4">
      Go further with PulsarOS
    </h2>
    <p class="mt-4 text-lg sm:text-xl text-on-surface-muted max-w-2xl mx-auto text-center font-normal leading-relaxed mb-16">
      Explore the ecosystem, find answers, and grab the resources you need.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-6">
      {links.map((link, index) => {
        const isBottomRow = index >= 3;
        return (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              "group flex flex-col justify-between rounded-[var(--radius-xl)] bg-surface-default border border-neutral-100 p-7 sm:p-8 hover:border-primary/40 hover:shadow-lg transition-all duration-300 hover:-translate-y-1",
              isBottomRow
                ? "sm:col-span-1 lg:col-span-3"
                : "sm:col-span-1 lg:col-span-2",
              index === 4 ? "sm:col-span-2 lg:col-span-3" : ""
            ]}
          >
            <div>
              <div class="flex items-center gap-4 mb-4">
                <span class="size-12 rounded-full bg-surface-muted border border-neutral-100 text-primary flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-white transition-colors">
                  <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={link.iconBody} />
                </span>
                <h3 class="font-display text-xl sm:text-2xl font-semibold text-on-surface-default tracking-tight">
                  {link.title}
                </h3>
              </div>
              <p class="text-sm sm:text-base text-on-surface-muted leading-relaxed mb-6">
                {link.description}
              </p>
            </div>
            <span class="inline-flex items-center gap-1.5 text-secondary font-medium text-sm group-hover:underline mt-auto">
              Open
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 7h10v10" />
                <path d="M7 17 17 7" />
              </svg>
            </span>
          </a>
        );
      })}
    </div>
  </div>
</section>