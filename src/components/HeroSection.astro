---
import { SITE_CONFIG } from '@/config/site';
import { getLocale } from '@/i18n/config';
import { getContent } from '@/i18n';

const locale = getLocale(Astro.url.pathname);
const t = getContent(locale);

// Contributors shown in the hero trust band. adilsongrima1-beep removed per request.
const AVATARS = [
  { src: "/assets/people/jaimegh.png", name: "JaimeGH" },
  { src: "/assets/people/victor1890.png", name: "Victor1890" },
  { src: "/assets/people/hhh.png", name: "hhh" },
  { src: "https://avatars.githubusercontent.com/u/332994032?v=4", name: "Angelo Mario Pavia" },
];
---

<!-- Preload instructions hoisted to head -->
<link as="image" href="/assets/desktop.png" fetchpriority="high" slot="head" />

<section id="hero-trigger" aria-label={t.hero.aria} class="relative min-h-screen flex flex-col items-center justify-start pt-16 sm:pt-24 px-4 sm:px-6 text-center bg-surface-default border-b border-neutral-100 overflow-hidden">

  <!-- Hero Text Group -->
  <header id="hero-text" class="max-w-4xl mx-auto flex flex-col items-center z-10">


    <h1 class="gsap-reveal-hero text-5xl sm:text-7xl lg:text-8xl font-bold font-display tracking-tight text-on-surface-default leading-[1.03] mb-6 text-balance" set:html={t.hero.titleHtml} />

    <!-- Rotating pull-up subhead (GSAP: one phrase pulls up at a time) -->
    <div class="gsap-reveal-hero pull-up-viewport relative h-[52px] sm:h-[68px] overflow-hidden w-full mb-8">
      <div class="pull-up-track absolute inset-0 flex items-center justify-center w-full">
        {t.hero.phrases.map((phrase) => (
          <div class="pull-up-item absolute top-1/2 -translate-y-1/2 left-1/2 -translate-x-1/2 text-[16px] sm:text-[20px] text-on-surface-muted leading-tight text-center">
            {phrase}
          </div>
        ))}
      </div>
    </div>

    <div class="gsap-reveal-hero flex flex-wrap items-stretch justify-center gap-3 sm:gap-4 w-full mb-10">
      <a
        href={SITE_CONFIG.downloadsUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex whitespace-nowrap items-center justify-center gap-1.5 bg-[#121212] border border-white/10 text-white rounded-[32px] px-5 py-3 min-h-[56px] sm:min-h-[65px] text-sm sm:text-base font-medium transition-colors hover:bg-white/10"
      >
        {t.hero.comingSoon}
        <span
          class="text-[21px] sm:text-[26px] font-bold tracking-tight"
          style="background: linear-gradient(to bottom, #ffffff 0%, #1a1a1a 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
        >
          2.0
        </span>
      </a>
      <a
        href="https://link.inled.es/discord"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex whitespace-nowrap items-center justify-center gap-1.5 bg-[#5865f2] text-white rounded-[32px] px-5 py-3 min-h-[56px] sm:min-h-[65px] text-sm sm:text-base font-medium transition-colors hover:bg-[#4752c4]"
        aria-label={t.hero.discord}
      >
        <i class="fa-brands fa-discord text-[20px] sm:text-[24px]"></i>
        {t.hero.discord}
      </a>
    </div>

    <!-- Community trust band -->
    <div class="gsap-reveal-hero community-band flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
      <span class="text-[15px] text-on-surface-muted">{t.hero.madeBy}</span>
      <div class="avatar-stack inline-flex items-center space-x-[-3px]">
        {AVATARS.map((person) => (
          <img
            src={person.src}
            alt={`${person.name} ${t.hero.avatarSuffix}`}
            class="w-9 h-9 rounded-full border border-neutral-100 bg-surface-default object-cover"
            width="36"
            height="36"
            loading="lazy"
            aria-label={person.name}
          />
        ))}
      </div>
      <span class="text-[15px] text-on-surface-muted">
        {t.hero.trust} <span class="text-on-surface-default font-medium">{t.hero.trustSource}</span>
      </span>
    </div>
  </header>

</section>

<style>
  /* Accessibility: with reduced motion, show every phrase instead of clipping to one */
  @media (prefers-reduced-motion: reduce) {
    .pull-up-viewport {
      overflow: visible;
      height: auto;
      min-height: auto;
    }
    .pull-up-item {
      opacity: 1;
      transform: none;
    }
  }
</style>
