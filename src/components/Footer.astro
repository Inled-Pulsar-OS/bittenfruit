---
import { SITE_CONFIG } from '@/config/site';
import { getLocale } from '@/i18n/config';
import { getContent, fill } from '@/i18n';

const locale = getLocale(Astro.url.pathname);
const t = getContent(locale);

// Hrefs stay in code, in the same order as the translated labels.
const columnHrefs: string[][] = [
  ['#overview', '#session-restore', '#sayri-ai', '#spotlight-search', '#window-management'],
  ['#connectivity', '#connectivity', '#connectivity', '#connectivity', '#bento-section'],
  ['#features', '#features', '#bento-section', '#bento-section'],
  ['#editions', '#editions', SITE_CONFIG.downloadsUrl, SITE_CONFIG.releasesUrl],
  [SITE_CONFIG.githubUrl, SITE_CONFIG.bugReportUrl, SITE_CONFIG.feedUrl, SITE_CONFIG.githubUrl, '#intelligence', '#overview'],
];

const footerDirectory = t.footer.columns.map((column, columnIndex) => ({
  title: column.title,
  links: column.links.map((label, linkIndex) => {
    const href = columnHrefs[columnIndex]?.[linkIndex] ?? '#';
    return { label, href, external: href.startsWith('http') };
  }),
}));

const footnotesParagraphs = t.footer.footnotes;
---

<!-- Apple Signature Editorial Footer -->
<footer class="bg-surface-muted text-on-surface-muted text-[12px] leading-[1.33337] font-normal py-10 px-4 sm:px-6 border-t border-neutral-100 transition-colors font-text select-none">
  <div class="max-w-6xl mx-auto space-y-4">

    <!-- Section 1: Footnotes Paragraph -->
    <div class="space-y-2.5 pb-4 border-b border-neutral-100 text-[11px] leading-normal text-on-surface-muted/90">
      {footnotesParagraphs.map((item, idx) => (
        <p id={`fn-${idx + 1}`} class="target:bg-primary/10 target:p-1.5 target:rounded-md transition-colors">
          {item}
        </p>
      ))}
    </div>

    <!-- Section 2: Apple Breadcrumb Trail Bar -->
    <div class="py-2.5 border-b border-neutral-100 flex items-center gap-2 text-[12px]">
      <a href="https://os.inled.es" class="text-on-surface-default hover:text-primary transition-colors flex items-center font-medium">
        <img src="/favicon.png" alt="PulsarOS" class="size-8 object-contain" />
        <span>PulsarOS</span>
      </a>
      <span class="text-on-surface-muted/50">›</span>
      <span class="text-on-surface-default font-normal">{t.footer.editionLabel}</span>
    </div>

    <!-- Section 3: Desktop 5-Column Directory Grid / Mobile Accordions -->
    <nav aria-label={t.footer.aria} class="py-4">

      <!-- Desktop Grid (md and up) -->
      <div class="hidden md:grid md:grid-cols-5 gap-8">
        {footerDirectory.map((col) => (
          <div>
            <h3 class="font-semibold text-on-surface-default mb-3 text-[12px] tracking-tight">{col.title}</h3>
            <ul class="space-y-2">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                    class="hover:text-on-surface-default hover:underline transition-colors block text-[12px]"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <!-- Mobile Accordions (below md) -->
      <div class="block md:hidden border-t border-neutral-100 divide-y divide-neutral-100">
        {footerDirectory.map((col) => (
          <details class="group py-3 cursor-pointer">
            <summary class="flex items-center justify-between text-[12px] font-semibold text-on-surface-default list-none py-1">
              <span>{col.title}</span>
              <span class="text-on-surface-muted text-xs group-open:rotate-180 transition-transform duration-200">
                ▾
              </span>
            </summary>
            <ul class="pt-2 pb-3 space-y-2.5 pl-2">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                    class="hover:text-on-surface-default transition-colors block text-[12px] text-on-surface-muted"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>

    </nav>

    <!-- Section 4: Shop / Ways to Get Action Bar -->
    <div class="py-3 border-b border-neutral-100 text-[12px] text-on-surface-muted" set:html={fill(t.footer.moreWaysHtml, { downloads: SITE_CONFIG.downloadsUrl, github: SITE_CONFIG.githubUrl })} />

    <!-- Section 5: Copyright & Legal Bar -->
    <div class="pt-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-[11px] text-on-surface-muted">
      <div set:html={t.footer.creditsHtml} />

      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <a href={SITE_CONFIG.githubUrl} target="_blank" rel="noopener" class="hover:text-on-surface-default hover:underline">{t.footer.legal.github}</a>
        <span>|</span>
        <a href={SITE_CONFIG.releasesUrl} target="_blank" rel="noopener" class="hover:text-on-surface-default hover:underline">{t.footer.legal.releases}</a>
        <span>|</span>
        <a href={SITE_CONFIG.bugReportUrl} target="_blank" rel="noopener" class="hover:text-on-surface-default hover:underline">{t.footer.legal.bug}</a>
        <span>|</span>
        <a href={SITE_CONFIG.feedUrl} target="_blank" rel="noopener" class="hover:text-on-surface-default hover:underline">{t.footer.legal.rss}</a>
        <span>|</span>
         <a href="https://license.inled.es" target="_blank" rel="noopener" class="hover:text-on-surface-default hover:underline">{t.footer.legal.license}</a>
        <span>|</span>
        <span class="text-on-surface-default font-medium">:)</span>
      </div>
    </div>

  </div>
</footer>
