<!-- Pulsar OS 2.0 Announcement Banner (Apple Blue) -->
<section
  id="pulsar-update-banner"
  class="bg-[var(--color-primary)] text-[var(--color-on-surface-inverse)] py-3 text-center text-sm font-medium select-none"
>
  <div class="max-w-7xl mx-auto px-4 flex flex-col items-center justify-center gap-3 sm:flex-row sm:items-center sm:justify-center text-center">
    <span>
      We&rsquo;re preparing the biggest update for Pulsar OS: version 2.0
    </span>
    <a
      href="https://link.inled.es/discord"
      target="_blank"
      rel="noopener noreferrer"
      class="underline underline-offset-4 hover:text-primary/90 transition-colors cursor-pointer inline-block"
    >
      Join Discord to stay up to date &rarr;
    </a>
  </div>
</section>