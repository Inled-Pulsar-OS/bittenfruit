---
const CONTRIBUTORS = [
  {
    name: "JaimeGH",
    role: "Founder and main developer of the project",
    avatar: "/assets/people/jaimegh.png",
    discord: "https://discord.com/users/1383822429851222150",
    discordUser: "jaimegh_es",
    github: "https://github.com/jaimegh-es",
  },
  {
    name: "Victor Jesús Rosario Vásquez (a.k.a. Victor1890)",
    role: "Contributor. Developed this website and more Pulsar OS things!",
    avatar: "/assets/people/victor1890.png",
    discord: "https://discord.com/users/1111731625663926382",
    discordUser: "vitico1890",
    github: "https://github.com/Victor1890",
  },
  {
    name: "Gautamvir Singh (a.k.a. hhh)",
    role: "Contributor. Creator of apps for Pulsar Store, Sayri prototype on SDL, Springboard, Supernova...",
    avatar: "/assets/people/hhh.png",
    discord: "https://discord.com/users/1237308179566690345",
    discordUser: "hhh092470",
    github: "https://github.com/ggg610523-lab",
  },
  {
    name: "adilsongrima1-beep",
    role: "Contributor. Added the first Notch, dock fixes and Spotlight design improvements.",
    avatar: "https://avatars.githubusercontent.com/u/272651648?v=4",
    discord: "https://discord.com/users/1173179597907570779",
    discordUser: "gogle.com",
    github: "https://github.com/adilsongrima1-beep",
  },
];
---

<!-- Contributors / Contribuidores -->
<section id="community" class="py-[var(--space-xl)] px-4 sm:px-6 border-t border-neutral-100" aria-label="People behind Pulsar OS">
  <div class="max-w-6xl mx-auto">
    <h2 class="font-display font-bold text-[34px] leading-[36px] text-on-surface-default text-center mb-3 tracking-tight">
      The people behind it
    </h2>
    <p class="text-on-surface-muted text-[17px] leading-[1.35] text-center mb-10 max-w-lg mx-auto">
      When you contribute to Pulsar OS, no matter how, you get recognized. We are a growing team, join us!
    </p>

    <div class="flex justify-center flex-wrap gap-6 max-w-[1040px] mx-auto">
      {CONTRIBUTORS.map((person) => (
        <div class="w-[250px] bg-surface-default border border-neutral-100 rounded-[20px] p-8 pb-7 text-center transition-all duration-200 hover:border-primary/30 hover:-translate-y-0.5">
          <img
            src={person.avatar}
            alt={`${person.name} avatar`}
            class="w-[72px] h-[72px] rounded-full object-cover mb-4 mx-auto"
            width="72"
            height="72"
            loading="lazy"
          />
          <div class="font-display text-[18px] font-bold tracking-tight text-on-surface-default">
            {person.name}
          </div>
          <div class="text-[14px] text-on-surface-muted leading-relaxed mt-1 mb-4">
            {person.role}
          </div>
          <div class="flex justify-center gap-2.5 flex-wrap">
            <a
              href={person.discord}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 border border-neutral-100 rounded-full text-[13px] font-semibold text-on-surface-muted transition-colors hover:text-primary hover:border-primary/30"
              aria-label={`${person.name} on Discord (@${person.discordUser})`}
            >
              <i class="fa-brands fa-discord" aria-hidden="true"></i>
              <span>{person.discordUser}</span>
            </a>
            {person.github && (
              <a
                href={person.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 border border-neutral-100 rounded-full text-[13px] font-semibold text-on-surface-muted transition-colors hover:text-primary hover:border-primary/30"
                aria-label={`${person.name} on GitHub`}
              >
                <i class="fa-brands fa-github" aria-hidden="true"></i>
                <span>GitHub</span>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
