---
import { SITE_CONFIG } from '@/config/site';
import { getLocale } from '@/i18n/config';
import { getContent } from '@/i18n';

const locale = getLocale(Astro.url.pathname);
const t = getContent(locale);
const editions = t.editions.cards;

const requirements = t.editions.requirements;
const bootExplainers = t.editions.explainers;
---

<section id="editions-section" aria-label={t.editions.aria} class="py-24 sm:py-32 bg-surface-default px-4 sm:px-6 border-t border-neutral-100">
  <div class="max-w-5xl mx-auto">
    <header class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-4xl sm:text-6xl font-bold font-display tracking-tight">{t.editions.title}</h2>
      <p class="text-on-surface-muted text-base sm:text-lg mt-4">{t.editions.subtitle}</p>
    </header>

    <!-- Base editions: Debian vs Arch -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
      {editions.map((ed) => (
        <article class="bg-surface-muted rounded-lg p-8 sm:p-12 border border-neutral-100 flex flex-col justify-between hover:border-primary/40 transition-colors">
          <div>
            <span class="text-xs font-semibold px-3 py-1 rounded-full bg-primary/10 text-primary uppercase tracking-wider inline-block mb-4">{ed.badge}</span>
            <h3 class="text-3xl font-semibold font-display mb-1">{ed.name}</h3>
            <p class="text-base font-medium text-secondary mb-4">{ed.headline}</p>
            <p class="text-sm text-on-surface-muted leading-relaxed mb-8">{ed.description}</p>
            <ul class="space-y-3 mb-10 border-t border-neutral-100 pt-6">
              {ed.bootVariants.map((v) => (
                <li class="flex items-center text-sm font-medium">
                  <svg class="size-4 text-primary mr-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                  {v}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <!-- Bootloader compatibility: GRUB = BIOS only, rEFInd = UEFI -->
    <div class="bg-surface-muted rounded-lg border border-neutral-100 p-8 sm:p-10 mb-12">
      <h3 class="text-2xl font-semibold font-display mb-2">{t.editions.bootTitle}</h3>
      <p class="text-sm text-on-surface-muted mb-6" set:html={t.editions.bootLeadHtml} />
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {bootExplainers.map((ex) => (
          <div class="rounded-md border border-neutral-100 bg-surface-default p-6">
            <h4 class="font-semibold font-display mb-2">{ex.title}</h4>
            <p class="text-sm text-on-surface-muted leading-relaxed" set:html={ex.body} />
          </div>
        ))}
      </div>
    </div>

    <!-- Compatibility helper: ask Google AI Mode about your exact PC -->
    <div class="bg-surface-muted rounded-lg border border-neutral-100 p-8 sm:p-10 mb-12">
      <h3 class="text-2xl font-semibold font-display mb-2">{t.editions.compatTitle}</h3>
      <p class="text-sm text-on-surface-muted mb-6">{t.editions.compatLead}</p>
      <form
        id="compat-check-form"
        class="flex flex-col sm:flex-row gap-3"
        autocomplete="off"
        data-query-template={t.editions.compatQuery}
      >
        <input
          id="compat-check-input"
          type="text"
          required
          placeholder={t.editions.compatPlaceholder}
          aria-label={t.editions.compatInputAria}
          class="flex-1 min-h-11 rounded-[var(--radius-full)] border border-neutral-100 bg-surface-default px-[21px] py-[11px] font-[var(--font-text)] text-[17px] outline-none focus:border-primary transition-colors"
        />
        <button type="submit" class="apple-button-primary whitespace-nowrap">{t.editions.compatButton}</button>
      </form>
      <p class="text-xs text-on-surface-muted mt-4">{t.editions.compatNote}</p>
    </div>

    <!-- Minimum requirements -->
    <div class="bg-surface-muted rounded-lg border border-neutral-100 p-8 sm:p-10 mb-12">
      <h3 class="text-2xl font-semibold font-display mb-6">{t.editions.requirementsTitle}</h3>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3 mb-6">
        {requirements.map((r) => (
          <li class="flex items-center text-sm font-medium">
            <svg class="size-4 text-primary mr-3 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            {r}
          </li>
        ))}
      </ul>
      <p class="text-sm text-on-surface-muted leading-relaxed" set:html={t.editions.requirementsNoteHtml} />
    </div>

    <!-- USB flashing advice -->
    <div class="rounded-lg border border-neutral-100 bg-[var(--color-tertiary)] p-8 sm:p-10 mb-12">
      <h3 class="text-2xl font-semibold font-display mb-4">{t.editions.usbTitle}</h3>
      <p class="text-sm text-on-surface-muted leading-relaxed" set:html={t.editions.usbBodyHtml} />
    </div>

    <!-- Downloads CTA: all downloads live on downloads-os.inled.es -->
    <div id="downloads-section" class="mt-12 text-center bg-surface-muted rounded-lg border border-neutral-100 p-8 sm:p-12">
      <h3 class="text-2xl sm:text-3xl font-semibold font-display tracking-tight mb-3">{t.editions.downloadsTitle}</h3>
      <p class="text-sm sm:text-base text-on-surface-muted max-w-2xl mx-auto mb-8">{t.editions.downloadsBody}</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
        <a href={SITE_CONFIG.downloadsUrl} target="_blank" rel="noopener" class="apple-button-primary">
          {t.editions.downloadsCta}
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { fill } from '@/i18n';

  function initCompatCheck() {
    const form = document.getElementById('compat-check-form') as HTMLFormElement | null;
    const input = document.getElementById('compat-check-input') as HTMLInputElement | null;
    if (!form || !input) return;
    if (form.dataset.bound === '1') return;
    form.dataset.bound = '1';

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const model = input.value.trim();
      if (!model) return;
      const template = form.dataset.queryTemplate || '';
      const query = fill(template, { model });
      window.open(`https://www.google.com/search?udm=50&q=${encodeURIComponent(query)}`, '_blank', 'noopener');
    });
  }

  document.addEventListener('astro:page-load', initCompatCheck);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCompatCheck);
  } else {
    initCompatCheck();
  }
</script>
