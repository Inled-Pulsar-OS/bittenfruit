---
import { GALLERY_FEATURES } from '@/config/site';

const galleryItems = GALLERY_FEATURES;

// SourceForge badge snippets (they inject their own remote script at load time)
const sfBadgeBase = `<div class="sf-root" data-id="4122850" data-badge="__BADGE__" style="width:125px"><a href="https://sourceforge.net/projects/pulsaros-inled/" target="_blank" rel="noopener">Pulsar OS</a></div>`;
const sfBadgesHtml =
  sfBadgeBase.replace('__BADGE__', 'oss-rising-star-white') +
  sfBadgeBase.replace('__BADGE__', 'oss-users-love-us-white');
---

<section id="gallery-section" class="pt-32 sm:pt-44 pb-24 sm:pb-32 bg-[#f5f5f7] text-[#1d1d1f] overflow-hidden border-t border-neutral-100 transition-colors lg:pt-24 lg:pb-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 mb-8 lg:mb-6">
    <h2 class="text-4xl sm:text-6xl font-semibold tracking-tight text-[#1d1d1f] leading-tight max-w-3xl">
      Get to know PulsarOS Bitten Fruit.
    </h2>
  </div>

  <!-- Horizontal Pinned Scroll Track -->
  <div id="gallery-track-wrapper" class="w-full overflow-x-auto lg:overflow-x-visible pb-10">
    <div id="media-card-track" class="flex gap-6 w-max items-stretch px-6 lg:px-[max(1.5rem,calc((100vw-80rem)/2))]">
      {galleryItems.map((item, index) => (
        <article
          class="group relative w-[min(82vw,340px)] sm:w-[min(56vw,400px)] lg:w-[min(30vw,380px)] h-[min(58vh,500px)] rounded-[24px] sm:rounded-4xl overflow-hidden bg-[#1d1d1f] text-white shadow-xl hover:shadow-2xl transition-all duration-500 cursor-pointer shrink-0 flex flex-col justify-between p-8 sm:p-10 select-none"
          data-gallery-card={index}
          data-gallery-video-src={item.video}
          data-gallery-poster={item.poster}
          data-gallery-title={item.title}
          data-clip-mode={item.videoRange?.mode}
          data-clip-offset={item.videoRange?.offsetFromEnd}
        >
          <!-- Video Background Layer -->
          <div class="absolute inset-0 z-0 bg-black">
            <video
              data-gallery-video={index}
              src={item.video}
              poster={item.poster}
              playsinline
              muted
              loop
              preload="metadata"
              class="w-full h-full object-cover object-center transition-transform duration-1000 scale-100 group-hover:scale-105"
            ></video>
            <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/30 to-black/40"></div>
          </div>

          <!-- Card Top Overlay Meta -->
          <div class="relative z-10 flex items-center justify-end">
            <!-- Maximize Indicator -->
            <button
              type="button"
              data-maximize-btn={index}
              aria-label={`Maximize ${item.title} video`}
              class="size-9 rounded-full bg-black/40 backdrop-blur-md border border-white/20 flex items-center justify-center text-white hover:bg-white hover:text-black transition-all group-hover:scale-110"
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 3 21 3 21 9"></polyline>
                <polyline points="9 21 3 21 3 15"></polyline>
                <line x1="21" y1="3" x2="14" y2="10"></line>
                <line x1="3" y1="21" x2="10" y2="14"></line>
              </svg>
            </button>
          </div>

          <!-- Card Bottom Overlay Content -->
          <div class="relative z-10 space-y-3">
            {item.logo && (
              <img src={item.logo} alt="" class="h-8 w-auto object-contain mb-2 filter drop-shadow" />
            )}
            {item.subtitle && (
              <span class="block text-xs font-medium text-white/70 uppercase tracking-wider drop-shadow-sm">
                {item.subtitle}
              </span>
            )}
            <h3 class="text-2xl sm:text-4xl font-bold tracking-tight text-white leading-tight drop-shadow-md">
              {item.title}
            </h3>
            <p class="text-sm sm:text-base text-white/80 font-normal leading-relaxed line-clamp-3 drop-shadow">
              {item.description}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Community badges + external link -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 mt-10 flex flex-wrap items-center justify-center gap-6">
    <Fragment set:html={sfBadgesHtml} />
    <a
      href="https://distrowatch.com/table.php?distribution=pulsar"
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-2 rounded-[var(--radius-full)] border border-[var(--color-secondary)] px-[21px] py-[11px] min-h-11 text-[17px] font-[var(--font-text)] text-[var(--color-secondary)] hover:bg-[var(--color-secondary)] hover:text-white transition-colors"
    >
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        <polyline points="15 3 21 3 21 9"></polyline>
        <line x1="10" y1="14" x2="21" y2="3"></line>
      </svg>
      View on DistroWatch
    </a>
  </div>
</section>

<script is:inline>
  // SourceForge badge loader (shared by both badges)
  (function () {
    var sc = document.createElement('script');
    sc.async = true;
    sc.src = 'https://b.sf-syn.com/badge_js?sf_id=4122850';
    var p = document.getElementsByTagName('script')[0];
    p.parentNode.insertBefore(sc, p);
  })();
</script>

<!-- Lightbox: click any card to maximize its video -->
<dialog id="gallery-lightbox" class="gallery-lightbox">
  <div class="relative w-[min(92vw,1200px)]">
    <video
      id="gallery-lightbox-video"
      playsinline
      controls
      preload="metadata"
      class="w-full aspect-video rounded-2xl bg-black shadow-2xl"
    ></video>
    <button
      type="button"
      data-lightbox-close
      aria-label="Close video"
      class="absolute -top-12 right-0 size-10 rounded-full bg-white/10 border border-white/20 text-white flex items-center justify-center hover:bg-white hover:text-black transition-colors"
    >
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
</dialog>

<style>
  /* IMPORTANT: never set display on the base rule — a closed <dialog> relies on
     the UA default display:none. Only style it while [open]. */
  .gallery-lightbox {
    border: none;
    padding: 0;
    max-width: none;
    max-height: none;
    margin: auto;
    /* Above GSAP-pinned sections (fixed, z-20) and the floating control bar (z-50) */
    z-index: 100;
  }
  .gallery-lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    /* Dim + blur the page behind the popup even if ::backdrop styling is unsupported */
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
  }
  .gallery-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
  }
</style>

<script>
  /** Keep a video looping inside its assigned segment of the source file.
   *  mode="head": plays from 0 and wraps before the final `offset` seconds.
   *  mode="tail": starts `offset` seconds before the end and loops that tail. */
  function attachVideoClip(video: HTMLVideoElement, mode: string, offset: number) {
    const enforce = () => {
      const duration = video.duration;
      if (!Number.isFinite(duration) || duration <= 0) return;
      const offsetSafe = Math.max(0, Math.min(offset, duration - 0.5));
      const start = mode === 'tail' ? duration - offsetSafe : 0;
      const end = mode === 'tail' ? duration : duration - offsetSafe;
      if (video.currentTime < start - 0.3 || video.currentTime >= end) {
        video.currentTime = start;
      }
    };
    video.addEventListener('loadedmetadata', enforce);
    video.addEventListener('timeupdate', enforce);
    video.addEventListener('seeked', enforce);
    enforce();
  }

  function initMediaGallery() {
    const lightbox = document.getElementById('gallery-lightbox') as HTMLDialogElement | null;
    const lightboxVideo = document.getElementById('gallery-lightbox-video') as HTMLVideoElement | null;
    if (!lightbox || !lightboxVideo) return;

    let openedCard: HTMLElement | null = null;

    // One persistent clip enforcement for the lightbox, driven by the opened card
    let lightboxClip: { mode: string; offset: number } | null = null;
    const enforceLightboxClip = () => {
      if (!lightboxClip) return;
      const { mode, offset } = lightboxClip;
      const duration = lightboxVideo.duration;
      if (!Number.isFinite(duration) || duration <= 0) return;
      const offsetSafe = Math.max(0, Math.min(offset, duration - 0.5));
      const start = mode === 'tail' ? duration - offsetSafe : 0;
      const end = mode === 'tail' ? duration : duration - offsetSafe;
      if (lightboxVideo.currentTime < start - 0.3 || lightboxVideo.currentTime >= end) {
        lightboxVideo.currentTime = start;
      }
    };
    lightboxVideo.addEventListener('loadedmetadata', enforceLightboxClip);
    lightboxVideo.addEventListener('timeupdate', enforceLightboxClip);

    const openLightbox = (card: HTMLElement) => {
      const src = card.getAttribute('data-gallery-video-src');
      const poster = card.getAttribute('data-gallery-poster');
      const title = card.getAttribute('data-gallery-title') || 'Feature video';
      if (!src) return;

      openedCard = card;
      // Pause inline preview while maximized
      card.querySelector('video')?.pause();

      lightboxVideo.src = src;
      lightboxVideo.poster = poster || '';
      lightboxVideo.setAttribute('aria-label', `Video demo for ${title}`);
      lightboxVideo.muted = false;
      lightboxVideo.currentTime = 0;
      lightbox.showModal();
      lightboxVideo.play().catch(() => {});

      // Lightbox playback honors the same clip range as the card preview
      const mode = card.dataset.clipMode;
      const offset = Number(card.dataset.clipOffset);
      lightboxClip = mode && Number.isFinite(offset) && offset > 0 ? { mode, offset } : null;
    };

    // Inline preview videos: respect the head/tail clip range of each card
    document.querySelectorAll<HTMLElement>('[data-gallery-card]').forEach((card) => {
      const video = card.querySelector<HTMLVideoElement>('video');
      const mode = card.dataset.clipMode;
      const offset = Number(card.dataset.clipOffset);
      if (video && mode && Number.isFinite(offset) && offset > 0) {
        attachVideoClip(video, mode, offset);
      }
    });

    const closeLightbox = () => {
      lightboxVideo.pause();
      lightboxVideo.removeAttribute('src');
      lightboxVideo.load();
      openedCard = null;
      lightboxClip = null;
    };

    document.querySelectorAll<HTMLElement>('[data-gallery-card]').forEach((card) => {
      const video = card.querySelector<HTMLVideoElement>('video');

      // Hover preview
      card.addEventListener('mouseenter', () => video?.play().catch(() => {}));
      card.addEventListener('mouseleave', () => {
        if (!lightbox.open) video?.pause();
      });

      // Click anywhere on the card to maximize
      card.addEventListener('click', () => openLightbox(card));
    });

    document.querySelectorAll<HTMLElement>('[data-maximize-btn]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const card = btn.closest<HTMLElement>('[data-gallery-card]');
        if (card) openLightbox(card);
      });
    });

    document.querySelectorAll<HTMLElement>('[data-lightbox-close]').forEach((btn) => {
      btn.addEventListener('click', () => lightbox.close());
    });

    lightbox.addEventListener('close', closeLightbox);
  }

  document.addEventListener('astro:page-load', initMediaGallery);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMediaGallery);
  } else {
    initMediaGallery();
  }
</script>
