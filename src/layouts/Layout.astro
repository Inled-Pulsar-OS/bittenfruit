---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import PulsarUpdateBanner from '@/components/PulsarUpdateBanner.astro';
import VersionTwoPopup from '@/components/VersionTwoPopup.astro';
import Footer from '@/components/Footer.astro';
import { SITE_CONFIG } from '@/config/site';
import { LOCALES, LOCALE_TAGS, localizePath, getLocale } from '@/i18n/config';
import { getContent } from '@/i18n';

interface Props {
  title?: string;
  description?: string;
}

const locale = getLocale(Astro.url.pathname);
const t = getContent(locale);

const {
  title = t.meta.title,
  description = t.meta.description,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
const ogImageUrl = new URL('/assets/desktop.png', canonicalURL).href;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": title,
  "operatingSystem": "Linux",
  "applicationCategory": "Desktop Environment / Operating System",
  "description": description,
  "inLanguage": LOCALE_TAGS[locale],
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock"
  },
  "downloadUrl": SITE_CONFIG.downloadsUrl,
  "license": "https://license.inled.es",
  "sameAs": [SITE_CONFIG.githubUrl]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "inLanguage": LOCALE_TAGS[locale],
  "mainEntity": t.faq.items.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---
<!doctype html>
<html lang={LOCALE_TAGS[locale]}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#ffffff" />

		<!-- Language alternates -->
		{LOCALES.map((item) => (
			<link rel="alternate" hreflang={LOCALE_TAGS[item]} href={new URL(localizePath(Astro.url.pathname, item), canonicalURL).href} />
		))}
		<link rel="alternate" hreflang="x-default" href={new URL(localizePath(Astro.url.pathname, 'en'), canonicalURL).href} />

		<!-- Pick the visitor's language on first visit: saved choice, then browser, then IP -->
		<script is:inline>
			(function () {
				var AUTO = ['es', 'it', 'fr', 'de'];
				var KEY = 'pulsar-locale';
				var path = location.pathname;
				var segment = path.split('/').filter(Boolean)[0];
				if (AUTO.indexOf(segment) !== -1) return;

				function target(loc) {
					if (!loc || loc === 'en') return;
					var rest = path === '/' ? '/' : path;
					return (rest === '/' ? '/' + loc + '/' : '/' + loc + rest) + location.search + location.hash;
				}

				function go(loc) {
					var url = target(loc);
					if (url && url !== path + location.search + location.hash) location.replace(url);
				}

				var saved = null;
				try { saved = localStorage.getItem(KEY); } catch (e) {}
				if (saved) { go(saved); return; }

				var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
				for (var i = 0; i < langs.length; i++) {
					var base = String(langs[i]).toLowerCase().split('-')[0];
					if (AUTO.indexOf(base) !== -1) { go(base); return; }
					if (base === 'en') break;
				}

				// Browser did not decide: fall back to the country IP (Cloudflare trace),
				// then to the time zone, without delaying the page for long.
				var byCountry = {
					ES: 'es', MX: 'es', AR: 'es', CO: 'es', CL: 'es', PE: 'es', VE: 'es', UY: 'es',
					EC: 'es', BO: 'es', PY: 'es', DO: 'es', GT: 'es', HN: 'es', SV: 'es', NI: 'es',
					PR: 'es', CR: 'es', PA: 'es', CU: 'es',
					IT: 'it', SM: 'it', VA: 'it',
					FR: 'fr', BE: 'fr', MC: 'fr', LU: 'fr',
					DE: 'de', AT: 'de', CH: 'de', LI: 'de'
				};

				function byTimeZone() {
					try {
						var zone = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
						if (zone.indexOf('Europe/Madrid') === 0) return 'es';
						if (zone.indexOf('Europe/Rome') === 0) return 'it';
						if (zone.indexOf('Europe/Paris') === 0 || zone.indexOf('Europe/Monaco') === 0) return 'fr';
						if (zone.indexOf('Europe/Berlin') === 0 || zone.indexOf('Europe/Vienna') === 0 || zone.indexOf('Europe/Zurich') === 0) return 'de';
					} catch (e) {}
					return null;
				}

				if (location.hostname === 'localhost' || location.hostname === '127.0.0.1') return;

				var done = false;
				var timer = setTimeout(function () {
					if (done) return;
					done = true;
					go(byTimeZone());
				}, 1200);

				fetch('/cdn-cgi/trace', { cache: 'no-store' })
					.then(function (res) { return res.ok ? res.text() : ''; })
					.then(function (text) {
						if (done) return;
						done = true;
						clearTimeout(timer);
						var match = /^loc=([A-Z]{2})$/m.exec(text || '');
						go(match ? byCountry[match[1]] : byTimeZone());
					})
					.catch(function () {
						if (done) return;
						done = true;
						clearTimeout(timer);
						go(byTimeZone());
					});
			})();
		</script>

		<!-- OpenGraph Meta Tags -->
		<meta property="og:site_name" content={SITE_CONFIG.name} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:locale" content={LOCALE_TAGS[locale]} />

		<!-- Twitter Card Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<!-- Structured Data (JSON-LD) -->
		<script type="application/ld+json" is:inline set:html={JSON.stringify(softwareSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

		<title>{title}</title>
	</head>
	<body class="bg-surface-default text-on-surface-default font-text antialiased selection:bg-primary/20 selection:text-primary min-h-screen">

		<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary focus:text-white focus:rounded-full focus:shadow-lg focus:outline-none">
			{t.a11y.skip}
		</a>

		<div id="main-root" class="min-h-screen flex flex-col justify-between">
			<Header />
			<PulsarUpdateBanner class="pt-14 z-50" />

			<main id="main-content" class="flex-1">
				<slot />
			</main>

			<VersionTwoPopup />

			<Footer />
		</div>

		<script>
			import { initAssetSpinners, cleanupAssetSpinners } from '@/lib/asset-spinner';

			document.addEventListener('astro:page-load', initAssetSpinners);
			document.addEventListener('astro:before-swap', cleanupAssetSpinners);
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initAssetSpinners);
			} else {
				initAssetSpinners();
			}

			function initSmoothAnchors() {
				document.addEventListener('click', (e) => {
					const target = e.target as HTMLElement | null;
					const anchor = target?.closest<HTMLAnchorElement>('a[href^="#"]');
					if (!anchor) return;

					const href = anchor.getAttribute('href');
					if (!href || href === '#') return;

					const targetElement = document.querySelector(href);
					if (targetElement) {
						e.preventDefault();
						const headerOffset = 80;
						const elementPosition = targetElement.getBoundingClientRect().top;
						const offsetPosition = elementPosition + window.scrollY - headerOffset;

						window.scrollTo({
							top: offsetPosition,
							behavior: 'smooth'
						});

						history.pushState(null, '', href);
					}
				});
			}

			document.addEventListener('astro:page-load', initSmoothAnchors);
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initSmoothAnchors);
			} else {
				initSmoothAnchors();
			}
		</script>
	</body>
</html>
